<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
       <isExposed>true</isExposed>

    <masterLabel>
        Blush Agentforce Floating Button
    </masterLabel>

    <description>
        A floating circular button that opens the Blush Project Guide
        in the native Salesforce Agentforce panel.
    </description>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property
                name="botId"
                type="String"
                label="Agentforce Bot ID"
                description="Optional agent ID. Leave blank to open the last-used Agentforce agent."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>