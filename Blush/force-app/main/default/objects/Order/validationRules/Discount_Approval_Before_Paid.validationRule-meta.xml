<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Discount_Approval_Before_Paid</fullName><active>true</active><description>Requirement G.25.</description>
<errorConditionFormula>AND(Max_Discount_Percent__c &gt; 0.10, NOT(ISPICKVAL(Approval_Status__c, &quot;Approved&quot;)), OR(ISPICKVAL(Payment_Status__c, &quot;Paid&quot;), ISPICKVAL(Status, &quot;Activated&quot;)))</errorConditionFormula>
<errorMessage>A line discount above 10% must be approved before the order is activated or marked as Paid.</errorMessage></ValidationRule>
